  align-items: center;
  gap: 6px;
}

.telemetry-val {
  font-weight: 800;
  color: var(--color-navy);
}

/* SVG Chart Elements */
.svg-interactive-canvas {
  width: 100%;
  height: auto;
  overflow: visible;
}

.radar-polygon-first {
  fill: rgba(82, 95, 225, 0.22);
  stroke: #525FE1;
  stroke-width: 2.5;
  stroke-linejoin: round;
}

.radar-polygon-overall {
  fill: rgba(255, 153, 85, 0.25);
  stroke: #FF9955;
  stroke-width: 2.5;
  stroke-linejoin: round;
  stroke-dasharray: 4 3;
}

.radar-vertex-node {
  fill: #FFFFFF;
  stroke: #525FE1;
  stroke-width: 2.5;
  cursor: pointer;
  transition: r 0.15s ease, fill 0.15s ease;
}

.radar-vertex-node:hover {
  r: 6.5;
  fill: var(--color-gold);
}

.spline-pacing-line {
  fill: none;
  stroke: #FF9955;
  stroke-width: 3;
  stroke-linecap: round;
}

/* Quad Matrix (Stationary on hover to prevent cursor flickering) */
.quad-point-node {
  cursor: pointer;
  transition: stroke-width 0.12s ease, stroke 0.12s ease, filter 0.12s ease;
}

.quad-point-node:hover {
  stroke: var(--color-gold) !important;
  stroke-width: 3.5px !important;
  filter: drop-shadow(0 2px 6px rgba(16, 55, 92, 0.45));
}

.svg-tooltip-box {
  pointer-events: none;
  filter: drop-shadow(0 4px 8px rgba(16, 55, 92, 0.2));
  font-family: inherit;
}

