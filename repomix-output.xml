import { useState, useEffect, type DragEvent } from "react";
import { createPortal } from "react-dom";
import { Link, useNavigate } from "react-router-dom";
import { parseAndIngestJSON, getStoredQuestionCount } from "@/db";
import "./Home.css";

const GITHUB_STARS_CACHE_KEY = "liprep_gh_stars_cache";

export default function Home() {
  const navigate = useNavigate();
  const [questionCount, setQuestionCount] = useState<number | null>(null);
  const [isUploading, setIsUploading] = useState(false);
  const [isDragging, setIsDragging] = useState(false);
  const [uploadError, setUploadError] = useState<string | null>(null);
  const [isAboutOpen, setIsAboutOpen] = useState(false);
  const [logoFailed, setLogoFailed] = useState(false);
  
  const [starCount, setStarCount] = useState<number | null>(() => {
    try {
      const cached = localStorage.getItem(GITHUB_STARS_CACHE_KEY);
      return cached ? Number(cached) : null;
    } catch {
      return null;
    }
  });

  useEffect(() => {
    getStoredQuestionCount().then((count) => setQuestionCount(count));

    // Offline-safe GitHub stars fetch
    async function fetchStars() {
      try {
        const res = await fetch("https://api.github.com/repos/liprep/liprep");
        if (res.ok) {
          const data = await res.json();
          if (typeof data.stargazers_count === "number") {
            setStarCount(data.stargazers_count);
            localStorage.setItem(GITHUB_STARS_CACHE_KEY, String(data.stargazers_count));
          }
        }
      } catch {
        // Retains cached star count or graceful omission when offline
      }
    }
    fetchStars();
  }, []);

  useEffect(() => {
    if (isAboutOpen) {
      document.body.style.overflow = "hidden";
    } else {
      document.body.style.overflow = "";
    }
    return () => {
      document.body.style.overflow = "";
    };
  }, [isAboutOpen]);

  async function processFile(file: File) {
    if (!file.name.endsWith(".json")) {
      setUploadError("Please upload a valid .json Question Bank file.");
      return;
    }
    try {
      setIsUploading(true);
      setUploadError(null);
      const imported = await parseAndIngestJSON(file);
      setQuestionCount(imported);
      navigate("/filter");
    } catch (err: unknown) {
      setUploadError(err instanceof Error ? err.message : "Error parsing JSON file.");
    } finally {
      setIsUploading(false);
    }
  }

  function handleDrop(e: DragEvent<HTMLDivElement>) {
    e.preventDefault();
    setIsDragging(false);
    const file = e.dataTransfer.files?.[0];
    if (file) processFile(file);
  }

  return (
    <div className="home-page-container animate-fade-in">
      <header className="home-top-nav">
        <div className="brand-logo-area">
          {!logoFailed ? (
            <img
              src="/liprep-logo.svg"
              alt="LiPrep"
              className="liprep-nav-img"
              onError={() => setLogoFailed(true)}
            />
          ) : (
            <div className="brand-logo-vector">
              <span className="logo-badge">Li</span>
              <span className="logo-text">Prep</span>
            </div>
          )}
        </div>

        <div className="home-nav-actions">
          {/* GitHub Star Button */}
          <a
            href="https://github.com/liprep/liprep"
            target="_blank"
            rel="noopener noreferrer"
            className="retro-btn github-star-btn"
          >
            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
            </svg>
            <span>Star</span>
            {starCount !== null && (
              <span className="github-star-counter">{starCount}</span>
            )}
          </a>

          {/* About Button - Matching Dimensions */}
          <button
            type="button"
            className="retro-btn home-about-btn"
            onClick={() => setIsAboutOpen(true)}
          >
            About
          </button>
        </div>
      </header>

      <main className="hero-split-layout">
        <div className="hero-left-pane">
          <h1 className="hero-main-title">
            <span className="hero-first-line">
              You can't spell{" "}
              <span className="saturday-badge-wrapper">
                Saturday
                <img
                  src="/hero-star.svg"
                  alt=""
                  className="hero-corner-star-img"
                  onError={(e) => {
                    (e.target as HTMLElement).style.display = "none";
                  }}
                />
              </span>
            </span>
            <br />
            <span className="hero-second-line">
              without spelling{" "}
              <span className="turd-badge-wrapper">
                <img
                  src="/hero-turd-blob.svg"
                  alt=""
                  className="hero-turd-blob-img"
                  onError={(e) => {
                    (e.target as HTMLElement).style.display = "none";
                  }}
                />
                <span className="turd-highlight-text">turd.</span>
              </span>
            </span>
          </h1>
          <p className="hero-subtext">but your test day doesn't have to be this way.</p>
        </div>

        <div className="hero-right-pane">
          <div
            className={`dropzone-card ${isDragging ? "is-dragging" : ""}`}
            onDragOver={(e) => {
              e.preventDefault();
              setIsDragging(true);
            }}
            onDragLeave={() => setIsDragging(false)}
            onDrop={handleDrop}
          >
            {questionCount && questionCount > 0 ? (
              <div className="loaded-bank-view">
                <div className="dropzone-icon loaded-icon">
                  <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                    <polyline points="22 4 12 14.01 9 11.01" />
                  </svg>
                </div>
                <h2 className="dropzone-title">Question Bank Ready</h2>
                <p className="dropzone-desc">
                  <strong>{questionCount}</strong> questions loaded in local storage
                </p>

                <div className="loaded-action-stack">
                  <Link
                    to="/filter"
                    className="retro-btn retro-btn-primary full-width-btn"
                    style={{ padding: "14px", fontSize: "1rem" }}
                  >
                    Continue to Dashboard →
                  </Link>

                  <label className="retro-btn full-width-btn" style={{ cursor: isUploading ? "wait" : "pointer" }}>
                    {isUploading ? "Importing..." : "Select new .json File"}
                    <input
                      type="file"
                      accept=".json"
                      disabled={isUploading}
                      style={{ display: "none" }}
                      onChange={(e) => {
                        const f = e.target.files?.[0];
                        if (f) processFile(f);
                      }}
                    />
                  </label>
                </div>
              </div>
            ) : (
              <div className="fresh-upload-view">
                <div className="dropzone-icon">
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                    <polyline points="17 8 12 3 7 8" />
                    <line x1="12" y1="3" x2="12" y2="15" />
                  </svg>
                </div>
                <h2 className="dropzone-title">
                  {isUploading ? "Ingesting Question Bank…" : "Import SAT Question Bank (.json)"}
                </h2>
                <p className="dropzone-desc">Drag & drop your College Board data file here</p>

                <label className="retro-btn retro-btn-indigo" style={{ cursor: isUploading ? "wait" : "pointer" }}>
                  {isUploading ? "Processing..." : "Select Local JSON"}
                  <input
                    type="file"
                    accept=".json"
                    disabled={isUploading}
                    style={{ display: "none" }}
                    onChange={(e) => {
                      const f = e.target.files?.[0];
                      if (f) processFile(f);
                    }}
                  />
                </label>
              </div>
            )}

            {uploadError && <p className="dropzone-error">{uploadError}</p>}
          </div>
        </div>
      </main>

      {/* Dead-Center About Modal via React Portal */}
      {isAboutOpen &&
        createPortal(
          <div className="full-screen-blur-overlay" onClick={() => setIsAboutOpen(false)}>
            <div className="about-modal-card animate-fade-in" onClick={(e) => e.stopPropagation()}>
              <div className="modal-header">
                <h3 style={{ fontSize: "1.2rem", fontWeight: 800 }}>About LiPrep</h3>
                <button
                  type="button"
                  className="retro-btn"
                  style={{ padding: "4px 10px" }}
                  onClick={() => setIsAboutOpen(false)}
                >
                  ✕
                </button>
              </div>
              <p className="about-modal-text">
                Liprep is short for Libre Prep. <br />
                <br />
                Test prep platforms have become disgustingly greedy so we felt the need for an open source, community-maintained, and zero bullshit platform to exist.
                <br />
                <br />
                Made by Zaid and Abdullah la3yoon SYE community, and beyond. Also, fuck Oneprep.
              </p>
            </div>
          </div>,
          document.body
        )}
    </div>
  );
}
</file>

<file path="src/pages/Practice.css">
.bluebook-app-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #FFFFFF;
  color: #1A202C;
  user-select: text;
  font-family: "IBM Plex Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  position: relative;
}

/* Header */
.bluebook-top-bar {
  height: 56px;
  background: #FFFFFF;
  border-bottom: 1.5px solid #E2E8F0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20px;
  position: sticky;
  top: 0;
  z-index: 50;
}

.top-bar-left-cluster {
  display: flex;
  align-items: center;
  gap: 12px;
}

.section-title-badge {
  font-weight: 700;
  font-size: 0.95rem;
  color: #082A4D;
}

/* Dead-center timer */
.top-bar-center-dead-center {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  align-items: center;
  pointer-events: auto;
}

.timer-pill-group {
  display: flex;
  align-items: center;
  background: #F8FAFC;
  border: 1px solid #CBD5E1;
  border-radius: var(--radius-pill);
  overflow: hidden;
}

.timer-pill-group .timer-pill {
  display: flex;
  align-items: center;
  gap: 6px;
  background: transparent;
  border: none;
  padding: 4px 12px;
  font-weight: 600;
  font-size: 0.88rem;
  cursor: pointer;
  color: #1E293B;
}

.timer-pause-btn {
  background: transparent;
  border: none;
  border-left: 1px solid #CBD5E1;
  padding: 4px 10px;
  cursor: pointer;
  font-size: 0.8rem;
  color: #1E293B;
}

.timer-pause-btn:hover {
  background: #E2E8F0;
}

.top-bar-tools {
  display: flex;
  align-items: center;
  gap: 8px;
}

.tool-button {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: #FFFFFF;
  border: 1.5px solid #CBD5E1;
  border-radius: 6px;
  padding: 6px 12px;
  font-weight: 600;
  font-size: 0.82rem;
  color: #082A4D;
  cursor: pointer;
  transition: background 0.15s ease, border-color 0.15s ease;
  white-space: nowrap;
}

.tool-button:hover {
  background: #F1F5F9;
  border-color: #082A4D;
}

.tool-button.active {
  background: #E2E8F0;
  border-color: #082A4D;
}

.bluebook-primary-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 10px 22px;
  background-color: #082A4D;
  color: #FFFFFF;
  font-weight: 700;
  font-size: 0.95rem;
  border-radius: 6px;
  border: none;
  cursor: pointer;
  transition: background-color 0.15s ease;
}

.bluebook-primary-btn:hover:not(:disabled) {
  background-color: #164E87;
}

.bluebook-primary-btn:disabled {
  background-color: #94A3B8;
  cursor: not-allowed;
}

.enter-key-badge {
  font-size: 0.8rem;
  opacity: 0.8;
  background: rgba(255, 255, 255, 0.2);
  padding: 1px 5px;
  border-radius: 4px;
}

/* Split Viewport */
.bluebook-viewport {
  flex: 1;
  display: grid;
  grid-template-columns: 1fr 1fr;
  min-height: calc(100vh - 120px);
}

.bluebook-viewport.no-stimulus {
  grid-template-columns: 1fr;
  max-width: 860px;
  margin: 0 auto;
  width: 100%;
}

.stimulus-column {
  border-right: 1.5px solid #E2E8F0;
  padding: 36px 44px;
  overflow-y: auto;
  font-size: 1.05rem;
  line-height: 1.7;
}

.question-column {
  padding: 36px 44px;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
}

/* Question Strap */
.bb-question-strap {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #F1F5F9;
  border: none;
  border-radius: 8px;
  padding: 8px 12px;
  margin-bottom: 24px;
}

.bb-strap-left {
  display: flex;
  align-items: center;
  gap: 12px;
}

.bb-number-square {
  background: #000000;
  color: #FFFFFF;
  font-weight: 800;
  font-size: 1.05rem;
  width: 32px;
  height: 32px;
  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bb-mark-review-btn {
  display: flex;
  align-items: center;
  gap: 6px;
  background: transparent;
  border: none;
  font-weight: 600;
  font-size: 0.95rem;
  color: #1A202C;
  cursor: pointer;
  padding: 4px 6px;
  border-radius: 4px;
}

.bb-mark-review-btn.is-marked {
  color: #D97706;
}

.bb-strap-right {
  display: flex;
  align-items: center;
  gap: 8px;
}

.bb-mode-tool-btn {
  background: transparent;
  border: 1.5px solid #CBD5E1;
  border-radius: 8px;
  padding: 6px 10px;
  cursor: pointer;
  color: #64748B;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bb-mode-tool-btn.is-active {
  background: #000000;
  color: #FFFFFF;
  border-color: #000000;
}

.stem-container {
  font-size: 1.05rem;
  line-height: 1.65;
  font-weight: 500;
  margin-bottom: 24px;
}

/* Docked Left Column Pane */
.docked-desmos-pane {
  display: flex;
  flex-direction: column;
  padding: 0;
  background: #FFFFFF;
}

.docked-desmos-header {
  height: 42px;
  padding: 0 16px;
  background: #F1F5F9;
  border-bottom: 1px solid #CBD5E1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.docked-calc-slot {
  flex: 1;
  width: 100%;
  height: calc(100% - 42px);
  min-height: 480px;
}

/* SPR Grid In */
.spr-container {
  margin-top: 16px;
  max-width: 320px;
}

.spr-label {
  display: block;
  font-weight: 700;
  font-size: 0.95rem;
  margin-bottom: 8px;
}

.spr-input {
  width: 100%;
  padding: 12px 16px;
  font-size: 1.2rem;
  font-weight: 700;
  border: 2px solid #94A3B8;
  border-radius: 6px;
  color: #082A4D;
  outline: none;
}

.spr-input:focus {
  border-color: #082A4D;
  box-shadow: 0 0 0 3px #E2E8F0;
}

.spr-input.is-correct {
  border-color: var(--color-green-dot);
  background: #F0FDF4;
}

.spr-input.is-incorrect {
  border-color: var(--color-coral-dot);
  background: #FEF2F2;
}

.spr-feedback {
  margin-top: 8px;
  font-size: 0.9rem;
  font-weight: 700;
}

/* Rationale & Attempt History Accordions */
.rationale-container,
.attempt-history-container {
  margin-top: 24px;
  background: #F8FAFC;
  border: 1.5px solid #CBD5E1;
  border-radius: 8px;
  overflow: hidden;
  font-family: "IBM Plex Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

.rationale-summary,
.attempt-history-summary {
  padding: 12px 16px;
  font-weight: 700;
  color: #082A4D;
  cursor: pointer;
  background: #EDF2F7;
  user-select: none;
  font-size: 0.95rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.rationale-body {
  padding: 18px;
  font-size: 0.95rem;
  line-height: 1.65;
  color: #1E293B;
}

.attempt-history-body {
  padding: 14px 16px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.attempt-history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border: 1px solid #E2E8F0;
  border-radius: 6px;
  padding: 8px 12px;
  font-size: 0.88rem;
}

.attempt-item-badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-weight: 700;
  padding: 2px 8px;
  border-radius: 4px;
  font-size: 0.8rem;
}

.attempt-item-badge.is-correct {
  background: #DCFCE7;
  color: #166534;
}

.attempt-item-badge.is-incorrect {
  background: #FEE2E2;
  color: #991B1B;
}

.attempt-meta-info {
  display: flex;
  align-items: center;
  gap: 12px;
  color: #64748B;
  font-size: 0.82rem;
}

/* Bottom Bar */
.bluebook-bottom-bar {
  height: 64px;
  background: #FFFFFF;
  border-top: 1.5px solid #E2E8F0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20px;
  position: sticky;
  bottom: 0;
