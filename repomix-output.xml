}

.module-telemetry-box.box-math {
  border-left: 4px solid #FF9955;
}

.telemetry-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 0.86rem;
}

.telemetry-label {
  color: #64748B;
  font-weight: 600;
