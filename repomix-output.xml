  background: #F8FAFC;
  border-radius: 8px;
  border: 1px solid #E2E8F0;
}

.bluebook-exclude-toggle input {
  margin-top: 2px;
}

/* Difficulty Band */
.difficulty-band-group {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.diff-tier-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.diff-tier-label {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.88rem;
  font-weight: 700;
  cursor: pointer;
}

.diff-dots-container {
  display: flex;
  gap: 6px;
}

.diff-dot-button {
  width: 15px;
  height: 15px;
  border-radius: 50%;
  border: 1.5px solid;
  background: #FFFFFF;
  cursor: pointer;
  padding: 0;
  transition: transform 0.1s ease;
}

.diff-dot-button.is-active {
