/* ==========================================================================
   LiPrep Diagnostic Intelligence & Analytics Dashboard
   ========================================================================== */

.analytics-overlay {
  position: fixed;
  inset: 0;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  z-index: 99999;
  background: rgba(16, 55, 92, 0.45);
  backdrop-filter: blur(14px) saturate(160%);
  -webkit-backdrop-filter: blur(14px) saturate(160%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: clamp(12px, 2.5vw, 32px);
  box-sizing: border-box;
  margin: 0;
}

.analytics-modal-shell {
  background: #FFFFFF;
  border: 3px solid var(--color-navy);
  border-radius: var(--radius-card);
  box-shadow: 0 24px 64px rgba(16, 55, 92, 0.28), 0 8px 0 var(--color-navy);
  max-width: 1180px;
  width: 100%;
  height: 92vh;
  max-height: 900px;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
  margin: 0 auto;
}

/* Modal Header */
.analytics-top-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 28px;
  background: #FFFFFF;
  border-bottom: 2px solid var(--color-border);
  gap: 16px;
  flex-wrap: wrap;
}

.analytics-header-left {
  display: flex;
  align-items: center;
  gap: 14px;
}

.analytics-badge-icon {
  width: 42px;
  height: 42px;
  border-radius: 12px;
  background: var(--color-navy);
  color: var(--color-gold);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.analytics-title-main {
  font-size: 1.4rem;
  font-weight: 800;
  color: var(--color-navy);
  margin: 0;
  letter-spacing: -0.4px;
}

.analytics-subtitle {
  font-size: 0.82rem;
  color: #64748B;
  font-weight: 600;
  margin: 2px 0 0;
}

/* Tabs */
.analytics-tabs-track {
  display: inline-flex;
  background: #F1F5F9;
  border: 1.5px solid var(--color-border);
  border-radius: 12px;
  padding: 4px;
  gap: 3px;
}

.analytics-tab-btn {
  border: none;
  background: transparent;
  padding: 7px 14px;
  font-size: 0.84rem;
  font-weight: 700;
  color: #64748B;
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.15s ease;
  display: inline-flex;
  align-items: center;
  gap: 7px;
}

.analytics-tab-btn svg {
  flex-shrink: 0;
}

.analytics-tab-btn:hover:not(.active) {
  color: var(--color-navy);
  background: rgba(255, 255, 255, 0.6);
}

.analytics-tab-btn.active {
  background: #FFFFFF;
  color: var(--color-navy);
  box-shadow: 0 2px 6px rgba(16, 55, 92, 0.12);
}

.analytics-close-btn {
  border: 2px solid var(--color-navy);
  background: #FFFFFF;
  color: var(--color-navy);
  width: 36px;
  height: 36px;
  border-radius: 10px;
  font-weight: 800;
  font-size: 1.1rem;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  box-shadow: 0 2px 0 var(--color-navy);
  transition: transform 0.1s ease, box-shadow 0.1s ease;
}

.analytics-close-btn:hover {
  transform: translateY(-1px);
  box-shadow: 0 3px 0 var(--color-navy);
  background: #F8FAFC;
}

.analytics-close-btn:active {
  transform: translateY(2px);
  box-shadow: none;
}

/* Scroll Body */
.analytics-body-scroll {
  flex: 1;
  overflow-y: auto;
  padding: 24px 28px 36px;
  display: flex;
  flex-direction: column;
  gap: 24px;
  background: #F8FAFC;
}

/* Executive KPI Grid */
.executive-kpi-banner {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
}

.kpi-stat-card {
  background: #FFFFFF;
  border: 2px solid var(--color-navy);
  border-radius: 16px;
  padding: 18px 20px;
  box-shadow: 0 4px 0 var(--color-navy);
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

.kpi-stat-card.kpi-highlight-ebrw {
  border-color: #525FE1;
  box-shadow: 0 4px 0 #525FE1;
}

.kpi-stat-card.kpi-highlight-math {
  border-color: #FF9955;
  box-shadow: 0 4px 0 #FF9955;
}

.kpi-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.kpi-label-cluster {
  display: flex;
  align-items: center;
  gap: 6px;
}

.kpi-label {
  font-size: 0.78rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: #64748B;
}

.kpi-pill-badge {
  font-size: 0.7rem;
  font-weight: 800;
  padding: 2px 8px;
  border-radius: 10px;
}

.kpi-val-row {
  display: flex;
  align-items: baseline;
  gap: 6px;
}

.kpi-value-huge {
  font-size: 2.2rem;
  font-weight: 900;
  line-height: 1;
  color: var(--color-navy);
  letter-spacing: -1px;
}

.kpi-subtext {
  font-size: 0.8rem;
  font-weight: 600;
  color: #64748B;
  margin-top: 6px;
}

/* Chart Canvas Card Frame */
.chart-panel-card {
  background: #FFFFFF;
  border: 2px solid var(--color-navy);
  border-radius: 18px;
  padding: 22px 24px;
  box-shadow: 0 4px 0 var(--color-navy);
  display: flex;
  flex-direction: column;
}

.chart-panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18px;
  padding-bottom: 12px;
  border-bottom: 1.5px solid #F1F5F9;
  flex-wrap: wrap;
  gap: 10px;
}

.chart-title-cluster h3 {
  margin: 0;
  font-size: 1.08rem;
  font-weight: 800;
  color: var(--color-navy);
  display: flex;
  align-items: center;
  gap: 8px;
}

.chart-title-cluster p {
  margin: 3px 0 0;
  font-size: 0.8rem;
  color: #64748B;
