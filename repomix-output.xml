  M: "Medium",
  H: "Hard",
  Easy: "Easy",
  Medium: "Medium",
  Hard: "Hard",
};

export function getDifficultyTierFromScoreBand(scoreBand: number): "Easy" | "Medium" | "Hard" {
  if (scoreBand <= 3) return "Easy";
  if (scoreBand <= 5) return "Medium";
  return "Hard";
